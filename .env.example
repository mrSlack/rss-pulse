# Local defaults. Change the database password before exposing the server to a network.
POSTGRES_DB=pulse
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse-local-only

# Nginx inside Compose listens on this host port. Keep WEB_BIND at 127.0.0.1
# when another host-level Nginx will proxy to it.
WEB_BIND=127.0.0.1
WEB_PORT=8090
POSTGRES_PORT=5432

# Optional override for the API's PostgreSQL connection string.
# DATABASE_URL=postgres://pulse:pulse-local-only@db:5432/pulse?sslmode=disable

# Maximum PostgreSQL connections of the API's pool: accepted range 2–100,
# defaults to 12. Keep it below the server's max_connections (100 by default).
# An invalid value stops the API at startup.
DB_MAX_CONNS=12

# RSS refresh workers: accepted range 1–32, defaults to 4.
RSS_REFRESH_CONCURRENCY=4

# Retention, in days; 0 disables. Unsaved articles older than ARTICLE_RETENTION_DAYS
# (30–3650, default 180) and decided quarantine records older than
# QUARANTINE_RETENTION_DAYS (7–3650, default 90) are deleted every 6 hours, as are
# shared feed sources (with their articles) that nobody has subscribed to for
# UNSUBSCRIBED_SOURCE_RETENTION_DAYS (1–3650, default 30).
ARTICLE_RETENTION_DAYS=180
QUARANTINE_RETENTION_DAYS=90
UNSUBSCRIBED_SOURCE_RETENTION_DAYS=30

# Required on the first start against an empty database. Set a unique password of at least 12 characters.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Keep false for loopback HTTP. Set true when HTTPS terminates at Nginx.
SESSION_COOKIE_SECURE=false

# Networks whose X-Real-IP header the API trusts as the client address for
# sign-in rate limiting (comma-separated CIDRs, or "none"). Empty uses the
# default: loopback, RFC 1918 and fc00::/7, which covers the Docker network
# between Nginx and the API. An invalid value stops the API at startup.
TRUSTED_PROXY_CIDRS=

# API logs: LOG_FORMAT is text or json (default text), LOG_LEVEL is debug, info,
# warn or error (default info). Health-check requests are logged only at debug.
# An invalid value stops the API at startup.
LOG_FORMAT=text
LOG_LEVEL=info

# Prometheus metrics: host:port or :port of a separate listener that serves only
# GET /metrics, for example :9090. Empty (default) disables metrics. The port is
# reachable from the Docker network only (expose, no host port) and is never
# proxied by Nginx. It must not be the API port 8080; an invalid value stops the
# API at startup. See docs/PROJECT.md, "Metrics".
METRICS_ADDR=

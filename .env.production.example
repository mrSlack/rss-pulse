# Replace both values before the first production start.
POSTGRES_DB=pulse
POSTGRES_USER=pulse
POSTGRES_PASSWORD=CHANGE_ME_TO_A_UNIQUE_LONG_RANDOM_VALUE

# A host-level Nginx or another TLS reverse proxy should forward HTTPS traffic
# to this local port and preserve the public Host header.
WEB_BIND=127.0.0.1
WEB_PORT=8090

RSS_REFRESH_CONCURRENCY=4
SESSION_COOKIE_SECURE=true

# Required for the first start against an empty production database.
# Remove these values after the first successful bootstrap.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_TO_A_UNIQUE_PASSWORD_OF_AT_LEAST_12_CHARACTERS

# Optional PostgreSQL connection string override.
# DATABASE_URL=postgres://pulse:password@db:5432/pulse?sslmode=disable

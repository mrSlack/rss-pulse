# Replace both values before the first production start.
POSTGRES_DB=pulse
POSTGRES_USER=pulse
POSTGRES_PASSWORD=CHANGE_ME_TO_A_UNIQUE_LONG_RANDOM_VALUE

# A host-level Nginx or another TLS reverse proxy should forward HTTPS traffic
# to this local port and preserve the public Host header.
WEB_BIND=127.0.0.1
WEB_PORT=8090

RSS_REFRESH_CONCURRENCY=4
SESSION_COOKIE_SECURE=true

# Maximum PostgreSQL connections of the API's pool: accepted range 2–100,
# defaults to 12. Keep it below the server's max_connections (100 by default).
# An invalid value stops the API at startup.
DB_MAX_CONNS=12

# Networks whose X-Real-IP header the API trusts as the client address for
# sign-in rate limiting (comma-separated CIDRs, or "none"). Empty uses the
# default: loopback, RFC 1918 and fc00::/7, which covers the Docker network
# between Nginx and the API. An invalid value stops the API at startup.
TRUSTED_PROXY_CIDRS=

# Retention, in days; 0 disables. Unsaved articles older than ARTICLE_RETENTION_DAYS
# (30–3650, default 180) and decided quarantine records older than
# QUARANTINE_RETENTION_DAYS (7–3650, default 90) are deleted every 6 hours, as are
# shared feed sources (with their articles) that nobody has subscribed to for
# UNSUBSCRIBED_SOURCE_RETENTION_DAYS (1–3650, default 30).
ARTICLE_RETENTION_DAYS=180
QUARANTINE_RETENTION_DAYS=90
UNSUBSCRIBED_SOURCE_RETENTION_DAYS=30

# Required for the first start against an empty production database.
# Remove these values after the first successful bootstrap.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_TO_A_UNIQUE_PASSWORD_OF_AT_LEAST_12_CHARACTERS

# Optional PostgreSQL connection string override.
# DATABASE_URL=postgres://pulse:password@db:5432/pulse?sslmode=disable

# PostgreSQL logs every statement that runs at least this many milliseconds
# (default 500; -1 disables, 0 logs every statement). Parameter values are never
# logged. A change restarts the database container on the next update; an
# invalid value stops PostgreSQL from starting.
DB_LOG_MIN_DURATION_MS=500

# API logs: LOG_FORMAT is json (production default) or text, LOG_LEVEL is debug,
# info, warn or error (default info). An invalid value stops the API at startup.
LOG_FORMAT=json
LOG_LEVEL=info
